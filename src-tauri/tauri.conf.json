{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sxmcaps",
  "version": "0.3.0",
  "identifier": "com.sxmcaps.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SxBoards — Universal Peripheral & Sound Studio",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": true,
        "backgroundColor": "#08070d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: asset://* http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "assets/soundpacks/**/*"
    ]
  }
}
